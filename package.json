{
  "name": "class-diary",
  "private": true,
  "version": "2.0.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "description": "선생님을 위한 스마트 학급일지",
  "author": "myungsin89-cell",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.classdiary.app",
    "productName": "학급일지",
    "publish": {
      "provider": "github",
      "owner": "myungsin89-cell",
      "repo": "new-daily"
    },
    "directories": {
      "output": "release-build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "학급일지",
      "artifactName": "ClassDiary_Setup_v${version}.${ext}"
    }
  }
}